	#AdditionalJar: kotlinx-coroutines-core-jvm-1.10.1
	#AdditionalJar: kotlinx-coroutines-android-1.10.1
#End Region

Sub Process_Globals
	'These global variables will be declared once when the application starts.
	'These variables can be accessed from all modules.
End Sub

Sub Globals
	'These global variables will be redeclared each time the activity is created.
	'These variables can only be accessed from this module.
	Dim adivery As Adivery
	Dim banner As AdiveryBannerAd

End Sub

Sub Activity_Create(FirstTime As Boolean)
	'Do not forget to load the layout file created with the visual designer. For example:
	Activity.LoadLayout("main")
	adivery.Initialize("738c5e66-2e4f-4ff0-8118-ef6c8235a5e9")
	adivery.SetUserId("test")
	adivery.SetLoggingEnabled(True)
	
End Sub

Sub Activity_Resume
	
	
End Sub

Sub Activity_Pause (UserClosed As Boolean)

End Sub

Sub ButtonBanner_Click

	banner.Initialize2("mainbanner", "06f0c520-3cc8-45c0-bbf1-f866f7eac525", banner.BANNER)
	
	Dim Width, Height, Left, Top As Int

	Width = 320dip
	Height = 50dip
	Top = 100%y - Height
	Left = (100%x - Width) / 2
	
	Activity.AddView(banner, Left, Top, Width, Height)
	
	Log("Banner called")
End Sub

Sub ButtonSmart_Click
	banner.Initialize2("smartbanner", "06f0c520-3cc8-45c0-bbf1-f866f7eac525", banner.SMART_BANNER)
	Activity.AddView(banner, 0, 100%y - 100dip, 100%x, 100dip)
	Log("smart banner initialized")
End Sub

Sub SmartBanner_Ad_Error(error As String)
	Log("smart banner load failed: " & error)
End Sub

Sub ButtonInterstitial_Click
	adivery.PrepareInterstitialAd("5788d25b-b7d6-442c-a562-b4bef582c18c")
	Log("interstitial called")
End Sub

Sub ButtonInterstitialShow_Click
	adivery.Show("5788d25b-b7d6-442c-a562-b4bef582c18c")
	Log("interstitial called")
End Sub

Sub ButtonRewarded_Click
	adivery.PrepareRewardedAd("29f509a9-3826-4ada-8404-4735aa14b510")
	Log("rewarded called")
End Sub

Sub ButtonRewardedShow_Click
	adivery.Show("29f509a9-3826-4ada-8404-4735aa14b510")
	Log("rewarded called")
End Sub

Sub ButtonAppOpen_Click
	adivery.PrepareAppOpenAd("c0b3bf0e-75a5-4183-ad86-2cc5c07c07d6")
End Sub

Sub ButtonAppOpenShow_Click
	adivery.ShowAppOpen("c0b3bf0e-75a5-4183-ad86-2cc5c07c07d6")
End Sub

'NOTE: no "ButtonOfferWall" exists yet in this layout (main.bal, a binary Designer file
'that can't be hand-edited safely). Add it via the B4A visual Designer - this Sub will
'bind automatically once a button with that name exists.
'The Offer Wall isn't loaded again after it closes: prepare it on every tap, and show it
'from On_Offer_Wall_Ad_Loaded.
Sub ButtonOfferWall_Click
	adivery.PrepareOfferWallAd("9cad440a-8271-49d2-8f81-0819268a5ce4")
	Log("offerwall called")
End Sub

Sub MainBanner_Ad_Loaded
	Log("banner ad loaded")
End Sub

Sub MainBanner_Ad_Clicked
	Log("banner ad clicked")
End Sub

Sub MainBanner_Ad_Error(error As String)
	Log("banner ad load failed: " & error)
End Sub

Sub On_Error(placement As String, error As String)
	Log("Error: " & error)
End Sub

