Build1=Default,b4a.example
File1=main.bal
FileGroup1=Default Group
Group=Default Group
Library1=core
Library2=adivery
ManifestCode='This code will be applied to the manifest file during compilation.~\n~'You do not need to modify it in most cases.~\n~'See this link for for more information: https://www.b4x.com/forum/showthread.php?p=78136~\n~AddManifestText(~\n~<uses-sdk android:minSdkVersion="21" android:targetSdkVersion="36"/>~\n~<supports-screens android:largeScreens="true" ~\n~    android:normalScreens="true" ~\n~    android:smallScreens="true" ~\n~    android:anyDensity="true"/>)~\n~SetApplicationAttribute(android:icon, "@drawable/icon")~\n~SetApplicationAttribute(android:label, "$LABEL$")~\n~CreateResourceFromFile(Macro, Themes.DarkTheme)~\n~'End of default text.~\n~~\n~'Adivery: on Android 13+ Google Play services returns an all-zero advertising ID unless the~\n~'app declares AD_ID. B4A doesn't merge the SDK's own manifest, so declare it (and the SDK's queries) here.~\n~AddPermission(com.google.android.gms.permission.AD_ID)~\n~AddPermission(android.permission.ACCESS_NETWORK_STATE)~\n~AddManifestText(~\n~<queries>~\n~    <package android:name="com.android.vending" />~\n~    <package android:name="com.farsitel.bazaar" />~\n~    <package android:name="ir.mservices.market" />~\n~    <package android:name="com.huawei.hwid" />~\n~    <package android:name="com.huawei.hms" />~\n~    <package android:name="com.huawei.hwid.tv" />~\n~    <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="market" /></intent>~\n~    <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="bazaar" /></intent>~\n~    <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="myket" /></intent>~\n~    <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="http" /></intent>~\n~    <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="https" /></intent>~\n~</queries>)~\n~~\n~'Fix: MissingForegroundServiceTypeException on targetSdkVersion 34+ (Starter service auto-foreground edge case)~\n~SetServiceAttribute(Starter, android:foregroundServiceType, shortService)~\n~~\n~'Adivery Ad activity~\n~AddApplicationText(~\n~<activity~\n~    android:name="com.adivery.sdk.networks.adivery.AdActivity"~\n~    android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"~\n~    android:exported="false" />)~\n~~\n~'Adivery AdMob config~\n~AddApplicationText(~\n~<meta-data android:name="com.google.android.gms.ads.AD_MANAGER_APP" android:value="true" />~\n~~\n~<activity~\n~    android:name="com.google.android.gms.ads.AdActivity"~\n~    android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"~\n~    android:theme="@android:style/Theme.Translucent" />)~\n~	~\n~AddApplicationText(~\n~<activity~\n~    android:name="com.adivery.sdk.networks.adivery.AdActivity"~\n~    android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"~\n~    android:exported="false" />)~\n~
Module1=Starter
NumberOfFiles=1
NumberOfLibraries=2
NumberOfModules=1
Version=13.5
@EndOfDesignText@
