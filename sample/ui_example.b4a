	Log("Interstitial Ad Loaded: " & placement)
End Sub

Sub On_Interstitial_Ad_Shown(placement As String)
	Log("Interstitial Ad Shown: " & placement)
End Sub

Sub On_Rewarded_Ad_Clicked(placement As String)
	Log("Rewarded Ad Clicked: " & placement)
End Sub

Sub On_Rewarded_Ad_Closed(placement As String, reward As Boolean)
	Log("Rewarded Ad Closed: " & placement & ", Reward: " & reward)
End Sub

Sub On_Rewarded_Ad_Loaded(placement As String)
	Log("Rewarded Ad Loaded: " & placement)
End Sub

Sub On_Rewarded_Ad_Shown(placement As String)
	Log("Rewarded Ad Shown: " & placement)
End Sub

Sub On_App_Open_Ad_Clicked(placement As String)
	Log("App Open Ad Clicked: " & placement)
End Sub

Sub On_App_Open_Ad_Closed(placement As String)
	Log("App Open Ad Closed: " & placement)
End Sub

Sub On_App_Open_Ad_Loaded(placement As String)
	Log("App Open Ad Loaded: " & placement)
End Sub

Sub On_App_Open_Ad_Shown(placement As String)
	Log("App Open Ad Shown: " & placement)
End Sub

Sub On_Offer_Wall_Ad_Clicked(placement As String)
	Log("Offer Wall Ad Clicked: " & placement)
End Sub

Sub On_Offer_Wall_Ad_Closed(placement As String)
	Log("Offer Wall Ad Closed: " & placement)
End Sub

